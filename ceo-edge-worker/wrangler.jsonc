{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceo-edge-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "CEO_TELEMETRY_KV",
      "id": "7cbe5e1dfc7149a1a2ebf8278e95761f"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CEO_APP_ORIGIN": "https://axim-ceo-department-app-363.pages.dev",
    "EMAILIT_API_URL": "https://api.emailit.com/v1/emails",
    "EMAIL_FROM": "AXiM Executive Alerts <alerts@example.com>"
  }
}